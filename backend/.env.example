# Required
MISTRAL_API_KEY=

# Optional — enables higher-quality recency search
TAVILY_API_KEY=

# Set to true to enable /admin/* endpoints and run-now trigger
DEBUG=false

# Set to true to run APScheduler inside the FastAPI process (dev convenience)
ENABLE_INPROCESS_SCHEDULER=false

# Timezone for scheduler (IANA format)
TZ=Asia/Kolkata

# LiteLLM tuning
LITELLM_REQUEST_TIMEOUT=60
