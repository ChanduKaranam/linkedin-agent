# Copy this file to .env and fill in your values

# LLM provider
MISTRAL_API_KEY=your_mistral_api_key_here

# Search (optional — falls back to DuckDuckGo if not set)
TAVILY_API_KEY=your_tavily_api_key_here

# Postgres database
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/trend_agent

# Set to true to run the pipeline scheduler inside the FastAPI process
ENABLE_INPROCESS_SCHEDULER=false

# Set to true to expose /docs and /admin/* endpoints
DEBUG=false

# LinkedIn OAuth (register an app at https://www.linkedin.com/developers/apps)
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:8000/admin/linkedin/callback
